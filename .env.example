# CloudSpace Configuration File
# Email Configuration
EMAIL_USER=your_email_here@gmail.com
EMAIL_PASS=your_app_password_here

# Server Configuration
PORT=5000
BASE_URL=http://localhost:5000
ENABLE_NGROK=true
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
FILES_META=./filesMeta.json

# Admin Credentials
SUPER_ADMIN_EMAIL=owner@cloudspace.com
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

ADMIN_EMAIL=admin@cloudspace.com
ADMIN_PASSWORD=your_admin_password_here

# Admin Privacy PIN (used for sensitive admin actions)
ADMIN_PRIVACY_PIN=your_admin_pin_here

# Coupon Configuration
COUPON_CODE=your_coupon_code_here
DISCOUNT_PERCENT=50
UPI_ID=your_upi_id_here
UPI_NAME=your_name_here
PRICE_PER_TB=450

# Cloud Coins Discount Configuration
COINS_DISCOUNT_ENABLED=true
COINS_PER_RUPEE=5
# 500 coins = 100 rs discount (so 5 coins = 1 rupee)

JWT_SECRET=your_jwt_secret_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_API_KEY=your_google_api_key_here

SYNC_FOLDER="C:\Users\YourUsername\OneDrive\Desktop\your-folder-path"

# Auto-generate plans on server startup (true by default)
# Set to false to prevent automatic plan regeneration and use existing plan-active.json
# If true, will only auto-generate if plan-active.json is empty or doesn't exist
AUTO_GENERATE_PLANS=true
